diff --git a/vulkan/context.cpp b/vulkan/context.cpp
index ded8cab..c9d08ce 100644
--- a/vulkan/context.cpp
+++ b/vulkan/context.cpp
@@ -1062,6 +1062,60 @@ bool Context::create_device(VkPhysicalDevice gpu_, VkSurfaceKHR surface,
 
 	LOGI("Using Vulkan GPU: %s\n", gpu_props.deviceName);
 
+	// Takedown: descriptor buffers crash AMD's own drivers on GCN cards
+	// (Polaris/Vega, e.g. RX 580): the renderer dies during startup. GCN only
+	// runs wave64, so a fixed 64-wide subgroup on an AMD driver identifies it.
+	// GRANITE_VULKAN_DESCRIPTOR_BUFFER (set to 0 by the launcher's "Use
+	// descriptor buffers" option) overrides the detection either way.
+	{
+		std::string env;
+		if (Util::get_environment("GRANITE_VULKAN_DESCRIPTOR_BUFFER", env))
+		{
+			if (Util::get_environment_bool("GRANITE_VULKAN_DESCRIPTOR_BUFFER", true))
+			{
+				LOGI("Descriptor buffers enabled by GRANITE_VULKAN_DESCRIPTOR_BUFFER.\n");
+			}
+			else
+			{
+				flags &= ~(CONTEXT_CREATION_ENABLE_DESCRIPTOR_BUFFER_BIT | CONTEXT_CREATION_ENABLE_DESCRIPTOR_HEAP_BIT);
+				LOGI("Descriptor buffers disabled by GRANITE_VULKAN_DESCRIPTOR_BUFFER.\n");
+			}
+		}
+		else if (gpu_props.vendorID == 0x1002 && gpu_props.apiVersion >= VK_API_VERSION_1_1 &&
+		         (flags & (CONTEXT_CREATION_ENABLE_DESCRIPTOR_BUFFER_BIT | CONTEXT_CREATION_ENABLE_DESCRIPTOR_HEAP_BIT)) != 0)
+		{
+			VkPhysicalDeviceDriverProperties driver = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES };
+			VkPhysicalDeviceSubgroupSizeControlProperties size_control = {
+				VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_PROPERTIES };
+			VkPhysicalDeviceProperties2 probe = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+			void **next = &probe.pNext;
+			const bool has_driver_props = gpu_props.apiVersion >= VK_API_VERSION_1_2 ||
+			                              has_extension(VK_KHR_DRIVER_PROPERTIES_EXTENSION_NAME);
+			const bool has_size_props = gpu_props.apiVersion >= VK_API_VERSION_1_3 ||
+			                            has_extension(VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME);
+			if (has_driver_props)
+			{
+				*next = &driver;
+				next = &driver.pNext;
+			}
+			if (has_size_props)
+			{
+				*next = &size_control;
+				next = &size_control.pNext;
+			}
+			vkGetPhysicalDeviceProperties2(gpu, &probe);
+
+			const bool amd_driver = driver.driverID == VK_DRIVER_ID_AMD_PROPRIETARY ||
+			                        driver.driverID == VK_DRIVER_ID_AMD_OPEN_SOURCE;
+			const bool wave64_only = size_control.minSubgroupSize == 64 && size_control.maxSubgroupSize == 64;
+			if (has_driver_props && has_size_props && amd_driver && wave64_only)
+			{
+				flags &= ~(CONTEXT_CREATION_ENABLE_DESCRIPTOR_BUFFER_BIT | CONTEXT_CREATION_ENABLE_DESCRIPTOR_HEAP_BIT);
+				LOGI("Descriptor buffers disabled for AMD GCN on the AMD driver.\n");
+			}
+		}
+	}
+
 	// FFmpeg integration requires Vulkan 1.3 core for physical device.
 	uint32_t minimum_api_version = (flags & video_context_flags) ? VK_API_VERSION_1_3 : VK_API_VERSION_1_1;
 	if (ext.device_api_core_version < minimum_api_version && (flags & video_context_flags) != 0)
