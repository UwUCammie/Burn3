+// Takedown (TAKEDOWN_GPU_SYNC): waits for the submission just made, so a hang
+// is reported with the one submission that did not finish.
+void Device::diag_sync_submission(QueueIndices physical_type, const std::string &desc)
+{
+	static uint64_t count = 0;
+	static bool reported = false;
+	static std::deque<std::string> recent;
+	static const char *queue_names[] = { "graphics", "compute", "transfer", "video-decode", "video-encode" };
+	const char *queue_name = unsigned(physical_type) < 5 ? queue_names[physical_type] : "?";
+	count++;
+	if (count == 1)
+		LOGI("[GPU-DIAG] TAKEDOWN_GPU_SYNC: waiting for every submission (timeout %u s).\n",
+		     GpuDiag::sync_timeout_seconds());
+
+	Fence drain;
+	submit_empty_nolock(physical_type, &drain, nullptr, -1);
+	const uint64_t start = Util::get_current_time_nsecs();
+	const bool done = drain && drain->wait_timeout(uint64_t(GpuDiag::sync_timeout_seconds()) * 1000000000ull);
+	const double ms = 1e-6 * double(Util::get_current_time_nsecs() - start);
+	if (drain)
+		drain->set_internal_sync_object();
+
+	char line[96];
+	snprintf(line, sizeof(line), "#%llu %s %.2f ms: ", static_cast<unsigned long long>(count), queue_name, ms);
+	if (done)
+	{
+		if (count <= 3 || (count % 2000) == 0)
+			LOGI("[GPU-DIAG] ok %s%s\n", line, desc.c_str());
+		recent.push_back(line + desc);
+		if (recent.size() > 8)
+			recent.pop_front();
+		return;
+	}
+
+	if (reported)
+		return;
+	reported = true;
+	LOGE("[GPU-DIAG] HANG: submission %sdid not finish in %u s (or the device was lost).\n", line,
+	     GpuDiag::sync_timeout_seconds());
+	LOGE("[GPU-DIAG] HANG: its programs: %s\n", desc.c_str());
+	for (auto &prev : recent)
+		LOGE("[GPU-DIAG] finished before it: %s\n", prev.c_str());
+	fflush(stdout);
+	fflush(stderr);
+}
