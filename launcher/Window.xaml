<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Burnout 3" Width="880" Height="620" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#111315" Foreground="#FAFAF7" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#303438"/><Setter Property="Foreground" Value="#FAFAF7"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontStyle" Value="Italic"/>
   <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#5A5E61"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Background" Value="#F0A126"/><Setter Property="Foreground" Value="#151515"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFB43E"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.38"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Background="#111315">
  <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ClipToBounds="True" Background="#25292D">
   <Image x:Name="DiscBackground" Stretch="UniformToFill" Opacity="0.55" IsHitTestVisible="False"/>
   <Rectangle x:Name="DiscShade" Visibility="Collapsed" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EE111315" Offset="0"/><GradientStop Color="#76111315" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Polygon Points="520,0 650,0 522,128 392,128" Fill="#343A3E" HorizontalAlignment="Right"/>
   <Polygon Points="680,0 706,0 578,128 552,128" Fill="#51575B" HorizontalAlignment="Right"/>
   <Polygon Points="728,0 740,0 612,128 600,128" Fill="#E99B24" HorizontalAlignment="Right"/>
   <Image x:Name="DiscCar" Width="220" Height="124" Margin="0,0,30,0" HorizontalAlignment="Right" Stretch="Uniform" IsHitTestVisible="False" Opacity="0.9"/>
   <StackPanel x:Name="FallbackBrand" Margin="32,22,0,0" VerticalAlignment="Top"><TextBlock Text="BURNOUT 3" FontFamily="Arial Black" FontStyle="Italic" FontSize="40"/><TextBlock Text="TAKEDOWN" FontFamily="Arial Black" FontStyle="Italic" FontSize="21" Foreground="#FFA52B" Margin="2,-3,0,0"/></StackPanel>
   <Image x:Name="DiscLogo" Width="300" Height="102" Margin="24,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.Name="Burnout 3 Takedown"/>
   <Border VerticalAlignment="Bottom" Background="#E99620" Height="5"/>
  </Grid>
  <Grid Grid.Row="1" Margin="24,16,24,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- Everything but PLAY, stacked so the row never runs off a narrow window; it scrolls on a very short one. -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
     <Button x:Name="Import" Content="CHOOSE ISO"/>
     <Button x:Name="ImportSave" Content="IMPORT SAVE"/>
     <Button x:Name="Mods" Content="MODS"/>
     <Button x:Name="Settings" Content="SETTINGS"/>
     <Button x:Name="Account" Content="ACCOUNT"/>
     <Button x:Name="Check" Content="CHECK FOR UPDATES" Margin="0"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock Text="LATEST NEWS" FontSize="19" FontWeight="Bold" FontStyle="Italic" Foreground="#FFAA2F"/><Border Height="1" Background="#55595B" Margin="18,0,0,0" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="1" Background="#202427" BorderBrush="#4A4E51" BorderThickness="1" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="News" Text="Loading news..." FontSize="16" LineHeight="27"/></ScrollViewer></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#1B1E20" BorderBrush="#55595B" BorderThickness="0,1,0,0" Padding="24,12,24,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Checking for updates..." Foreground="#CCD0D2" Margin="0,0,0,8"/>
     <ProgressBar x:Name="Progress" Height="6" Margin="0,0,0,8" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="#FFA52B" Background="#363B3E"/>
     <TextBlock x:Name="Version" FontSize="11" Foreground="#9DA4A8"/>
    </StackPanel>
    <Button x:Name="Play" Grid.Column="2" Content="PLAY" Background="#E99620" Foreground="#101214" BorderBrush="#FFBF5C" FontSize="22" Padding="40,14" Margin="0" MinWidth="200" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
