diff --git b/vulkan/gpu_diag.cpp b/vulkan/gpu_diag.cpp
new file mode 100644
index 0000000..7fbcf63
--- /dev/null
+++ b/vulkan/gpu_diag.cpp
@@ -0,0 +1,49 @@
+#include "gpu_diag.hpp"
+#include "environment.hpp"
+#include <mutex>
+#include <unordered_map>
+#include <stdio.h>
+
+namespace Vulkan
+{
+namespace GpuDiag
+{
+static std::mutex names_lock;
+static std::unordered_map<Util::Hash, std::string> &names()
+{
+	static std::unordered_map<Util::Hash, std::string> map;
+	return map;
+}
+
+bool sync_submits()
+{
+	static const bool on = Util::get_environment_bool("TAKEDOWN_GPU_SYNC", false);
+	return on;
+}
+
+unsigned sync_timeout_seconds()
+{
+	static const unsigned seconds = Util::get_environment_uint("TAKEDOWN_GPU_SYNC_TIMEOUT", 5);
+	return seconds ? seconds : 5;
+}
+
+void name_shader(Util::Hash hash, const std::string &name)
+{
+	std::lock_guard<std::mutex> holder{names_lock};
+	names().emplace(hash, name);
+}
+
+std::string shader_name(Util::Hash hash)
+{
+	{
+		std::lock_guard<std::mutex> holder{names_lock};
+		auto itr = names().find(hash);
+		if (itr != names().end())
+			return itr->second;
+	}
+	char buf[24];
+	snprintf(buf, sizeof(buf), "#%016llx", static_cast<unsigned long long>(hash));
+	return buf;
+}
+}
+}
diff --git b/vulkan/gpu_diag.hpp b/vulkan/gpu_diag.hpp
new file mode 100644
index 0000000..bd5010c
--- /dev/null
+++ b/vulkan/gpu_diag.hpp
@@ -0,0 +1,25 @@
+// Takedown: GPU hang diagnostics for players' machines (no debugger there).
+//
+// TAKEDOWN_GPU_SYNC=1 waits for every submission to finish before the next one
+// is recorded into the queue, so a GPU hang is pinned to the one submission
+// that never completed; its programs (by name) and the last good ones are
+// logged with [GPU-DIAG]. Slow, for diagnosis only.
+//
+// Shader names (template path and defines, or the GS program name) are kept
+// for every shader so these logs and Granite's post-mortem report name them.
+#pragma once
+
+#include "hash.hpp"
+#include <string>
+
+namespace Vulkan
+{
+namespace GpuDiag
+{
+bool sync_submits();
+// Seconds a synchronous submission may take before it is reported as hung.
+unsigned sync_timeout_seconds();
+void name_shader(Util::Hash hash, const std::string &name);
+std::string shader_name(Util::Hash hash);
+}
+}
diff --git b/vulkan/low_vram.cpp b/vulkan/low_vram.cpp
new file mode 100644
index 0000000..cff0345
--- /dev/null
+++ b/vulkan/low_vram.cpp
@@ -0,0 +1,57 @@
+#include "low_vram.hpp"
+#include "device.hpp"
+#include "environment.hpp"
+#include "logging.hpp"
+#include <algorithm>
+#include <atomic>
+#include <mutex>
+#include <string>
+
+namespace Vulkan
+{
+namespace LowVram
+{
+static constexpr VkDeviceSize kLowVramHeapLimit = VkDeviceSize(1024) * 1024 * 1024;
+static std::once_flag decided;
+static std::atomic<bool> low_vram{ false };
+
+bool enabled(const Device &device)
+{
+	std::call_once(decided, [&]() {
+		const auto &props = device.get_memory_properties();
+		VkDeviceSize heap = 0;
+		for (uint32_t i = 0; i < props.memoryHeapCount; i++)
+			if ((props.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0)
+				heap = std::max(heap, props.memoryHeaps[i].size);
+
+		std::string setting = Util::get_environment_string("TAKEDOWN_LOW_VRAM", "");
+		const char *why;
+		bool on;
+		if (setting == "1")
+		{
+			on = true;
+			why = "forced by TAKEDOWN_LOW_VRAM=1";
+		}
+		else if (setting == "0")
+		{
+			on = false;
+			why = "turned off by TAKEDOWN_LOW_VRAM=0";
+		}
+		else
+		{
+			on = heap != 0 && heap <= kLowVramHeapLimit;
+			why = "automatic";
+		}
+		LOGI("Low video memory mode: %s (device-local heap %llu MiB, %s).\n", on ? "on" : "off",
+		     static_cast<unsigned long long>(heap / (1024 * 1024)), why);
+		low_vram = on;
+	});
+	return low_vram;
+}
+
+bool active()
+{
+	return low_vram;
+}
+}
+}
diff --git b/vulkan/low_vram.hpp b/vulkan/low_vram.hpp
new file mode 100644
index 0000000..58755f0
--- /dev/null
+++ b/vulkan/low_vram.hpp
@@ -0,0 +1,21 @@
+// Takedown: low video memory mode, for GPUs whose largest device-local heap is
+// 1 GiB or less (on many APUs it is only the 256 MiB BIOS carve-out). The GS
+// image slab, the texture budget and the native scene's caches are then kept
+// small so the heap is not overfilled; it only costs some speed.
+//
+// On by itself on such GPUs; TAKEDOWN_LOW_VRAM=1 forces it on, =0 off.
+#pragma once
+
+#include "vulkan_headers.hpp"
+
+namespace Vulkan
+{
+class Device;
+namespace LowVram
+{
+// Decided on the first call (one device per process) and logged once.
+bool enabled(const Device &device);
+// The decision made by the first enabled() call; false before it.
+bool active();
+}
+}
