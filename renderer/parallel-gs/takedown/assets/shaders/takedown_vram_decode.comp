#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
// One texture level decoded from NativeScene's GPU copy of GS memory as RGBA8,
// as TakedownNativeMemory::decode does it from the host copy: texel (i, j) reads
// ((i & umsk) + x) | ufix, ((j & vmsk) + y) | vfix of the level's layout.
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer Vram { uint vram[]; };
layout(std140, set = 0, binding = 1) uniform Palette { uvec4 palette[64]; };
layout(rgba8, set = 0, binding = 2) writeonly uniform image2D Level;
// Palette colours to read from this memory instead (a CLUT loaded from bytes an exact draw wrote): the byte
// address of the entry, bit 0 set for a 16-bit one; ~0u: palette[] has the colour.
layout(std140, set = 0, binding = 3) uniform PaletteSource { uvec4 palette_source[64]; };

layout(push_constant) uniform Constants
{
	uint base_block, tbw, psm, texa; // texa: AEM | TA0 << 8 | TA1 << 16
	uint x, y, width, height;
	uint umsk, ufix, vmsk, vfix;
} c;

#define TEX_LOAD(w) vram[(w)]
uint palette_entry(uint i);
#define PALETTE(i) palette_entry(i)
#include "takedown_vram.h"

uint palette_entry(uint i)
{
	uint source = palette_source[i >> 2u][i & 3u];
	if (source == 0xffffffffu)
		return palette[i >> 2u][i & 3u];
	if ((source & 1u) == 0u)
		return vram[(source & VRAM_MASK) >> 2u];
	return unpack16(tex_half((source & VRAM_MASK) >> 1u), (c.texa & 1u) != 0u, (c.texa >> 8u) & 0xffu, (c.texa >> 16u) & 0xffu);
}

void main()
{
	uvec2 ij = gl_GlobalInvocationID.xy;
	if (ij.x >= c.width || ij.y >= c.height)
		return;
	uint u = (((ij.x & c.umsk) + c.x) | c.ufix) & 2047u;
	uint v = (((ij.y & c.vmsk) + c.y) | c.vfix) & 2047u;
	uint texel = fetch_texel(u, v, c.base_block, c.tbw, c.psm, (c.texa & 1u) != 0u, (c.texa >> 8u) & 0xffu,
	                         (c.texa >> 16u) & 0xffu);
	imageStore(Level, ivec2(ij), unpackUnorm4x8(texel));
}
