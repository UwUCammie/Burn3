#include <winver.h>
1 ICON "b3.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @TAKEDOWN_GAME_VERSION_MAJOR@,@TAKEDOWN_GAME_VERSION_MINOR@,@TAKEDOWN_GAME_VERSION_PATCH@,0
 PRODUCTVERSION @TAKEDOWN_GAME_VERSION_MAJOR@,@TAKEDOWN_GAME_VERSION_MINOR@,@TAKEDOWN_GAME_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Takedown Recomp"
   VALUE "FileVersion", "@TAKEDOWN_GAME_VERSION@"
   VALUE "ProductName", "Takedown Recomp"
   VALUE "ProductVersion", "@TAKEDOWN_GAME_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
